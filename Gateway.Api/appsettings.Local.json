{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": "http://localhost:4200"
  },
  "Otlp": {
    "Endpoint": "http://localhost:4317",
    "Protocol": "http/protobuf",
    "TracesEndpoint": "",
    "MetricsEndpoint": ""
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/app-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "docs-auth": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/docs/auth/openapi/v1.json",
          "Methods": [ "GET" ]
        },
        "Transforms": [ { "PathRemovePrefix": "/docs/auth" } ]
      },
      "docs-recordings": {
        "ClusterId": "recording-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/docs/recordings/openapi/v1.json",
          "Methods": [ "GET" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/docs/recordings" }
        ]
      }
    }
  }
}