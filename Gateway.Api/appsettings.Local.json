{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": "http://localhost:4200"
  },
  "ReverseProxy": {
    "Routes": {
      "docs-auth": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/docs/auth/openapi/v1.json",
          "Methods": [ "GET" ]
        },
        "Transforms": [ { "PathRemovePrefix": "/docs/auth" } ]
      }
    }
  }
}