{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "https://auth.stt.local",
    "Audience": "stt-api",
    "MetadataAddress": "https://authservice/.well-known/openid-configuration"
  },
  "KeyVault": {
    "Uri": "https://kv-stt-dev.vault.azure.net/"
  },
  "ReverseProxy": {
    "Routes": {
      "auth-login": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/auth/login",
          "Methods": [ "POST" ]
        }
      },
      "auth-refresh": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/auth/refresh",
          "Methods": [ "POST" ]
        }
      },
      "auth-logout": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/auth/logout",
          "Methods": [ "POST" ]
        }
      },
      "auth-register": {
        "ClusterId": "auth-cluster",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/user/register",
          "Methods": [ "POST" ]
        }
      },
      "user-me": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/user/me",
          "Methods": [ "GET" ]
        }
      },
      "recordings": {
        "ClusterId": "recording-cluster",
        "Match": {
          "Path": "/api/recordings/{**catch-all}",
          "Methods": [ "GET" ]
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth": { "Address": "https+http://authservice" }
        }
      },
      "recording-cluster": {
        "Destinations": {
          "recording": {
            "Address": "https+http://recordingapi"
          }
        }
      }
    }
  }
}
